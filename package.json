{
  "name": "objectle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:validate": "tsx scripts/content.ts validate",
    "content:report": "tsx scripts/content.ts report",
    "content:review": "tsx scripts/content.ts review",
    "schedule:build": "tsx scripts/content.ts schedule",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "better-sqlite3": "^12.0.0",
    "zod": "^3.24.0",
    "express-rate-limit": "^7.5.0",
    "cors": "^2.8.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "vitest": "^3.0.0",
    "@playwright/test": "^1.51.0",
    "concurrently": "^9.1.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
